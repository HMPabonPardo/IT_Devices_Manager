<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivFotoPerfil"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_menu_myplaces"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:id="@+id/tvNombrePerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hector Pabon"
                android:textStyle="bold"
                android:textColor="#000000"/>
            <TextView
                android:id="@+id/tvDetallePerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hmapabonp@poligran.edu.co • Desarrollador"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

    <Button
        android:id="@+id/btnMenuTransacciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movimientos"
        android:drawableLeft="@android:drawable/ic_menu_agenda"
        android:backgroundTint="@android:color/transparent"
        android:textColor="#000000"
        android:gravity="left|center_vertical"/>

</LinearLayout>